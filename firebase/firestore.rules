rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /profiles/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid}/{collection}/{document} {
      allow read, write: if request.auth != null && request.auth.uid == uid
        && (collection == 'favorites' || collection == 'history');
    }
  }
}
